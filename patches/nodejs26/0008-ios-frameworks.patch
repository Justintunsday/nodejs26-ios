           'libraries': [ '-framework CoreFoundation -framework Security' ],
         }],
         [ 'node_shared_simdutf=="false" and node_use_bundled_v8!="false"', {

--- a/node.gypi
+++ b/node.gypi
@@ -267,10 +267,12 @@
       'defines': [ 'NODE_BUNDLED_ZSTD' ],
     }],
 
-    [ 'OS=="mac"', {
+    [ 'OS=="mac" or OS=="ios"', {
