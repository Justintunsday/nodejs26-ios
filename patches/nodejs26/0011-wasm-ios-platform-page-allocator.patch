# =============================================================================
# nodejs 26.13.0 iPhoneOS Phase B fix: wasm code spaces from the plain
# platform page allocator (no CodeRange/MAP_JIT assumption)
# =============================================================================
# Base:    nodejs/node v26.13.0 + patches 0001..0009
# Applied: by scripts/build-ios-runtime-node26.sh after 0001..0009.
#
# Device evidence (artifact sha 627f12d3..., iPhone SE 2 / iOS 16.1.1):
#   Node 26 JIT is now device-verified: --version/--jitless OK, and with
#   --single-threaded the JIT loop (jit_loop=5999999), built-in fetch
#   (HTTP 200), TLS and the event loop all work. WebAssembly however traps:
#   SIGTRAP/EXC_BREAKPOINT V8_Fatal, stack:
#     V8_Fatal <- WasmCodeManager::TryAllocate <- NewNativeModule <-
#     WasmEngine::SyncCompile <- WebAssemblyModule(...)
#
# Root cause: V8 14.6's wasm-code-manager.cc has a Chrome-iOS-only
# GetPageAllocator() branch: on V8_OS_IOS it requires
# IsolateGroup::current()->GetCodeRange()->page_allocator() and otherwise
# hits UNREACHABLE(), encoding the Chrome iOS assumption that MAP_JIT can be
# used exactly once and the CodeRange already consumed it. This Node build
# has no pointer compression, so IsolateGroup has no CodeRange, and this
# port removed MAP_JIT entirely (0005/0007) - the UNREACHABLE is hit.
#
# Fix:
#   * GetPageAllocator(): fall back to GetPlatformPageAllocator() on iOS when
#     no CodeRange page allocator exists (keep the existing CodeRange branch).
#   * TryAllocate(): reserve wasm code space with plain kNoAccess on iOS
#     instead of kNoAccessWillJitLater (a MAP_JIT hint with no MAP_JIT).
# Existing 0007 code already commits wasm ranges RW->RX and registers them in
# WasmCodeManager::Commit(), so the write scopes can toggle them.
# =============================================================================

--- a/deps/v8/src/wasm/wasm-code-manager.cc
+++ b/deps/v8/src/wasm/wasm-code-manager.cc
@@ -2174,10 +2174,14 @@
       }
     }
   }
-  // On iOS, the CodeRange must be initialized and provide a valid page
-  // allocator. Falling through to GetPlatformPageAllocator() would fail
-  // because MAP_JIT can only be called once per process.
-  UNREACHABLE();
+  // nodejs26 Phase B fix (0011): this port builds without pointer
+  // compression, so IsolateGroup has no CodeRange, and MAP_JIT is disabled on
+  // iOS (patches 0005/0007) - there is no "only one MAP_JIT per process"
+  // constraint to satisfy. Wasm code space is therefore reserved as plain
+  // PROT_NONE memory from the platform page allocator;
+  // WasmCodeManager::Commit() grants RW then RX and registers the range with
+  // RegisterIOSCodeRange() for RwxMemoryWriteScope toggling.
+  return GetPlatformPageAllocator();
 #else
   return GetPlatformPageAllocator();
 #endif  // V8_OS_IOS
@@ -2319,7 +2323,14 @@
                     PageAllocator::AllocationHint().WithAddress(
                         reinterpret_cast<void*>(hint)),
                     allocate_page_size,
-                    PageAllocator::Permission::kNoAccessWillJitLater);
+#if defined(V8_OS_IOS)
+                    // nodejs26 Phase B fix (0011): no MAP_JIT on iOS; reserve
+                    // plain PROT_NONE pages (Commit() grants RW then RX).
+                    PageAllocator::Permission::kNoAccess
+#else
+                    PageAllocator::Permission::kNoAccessWillJitLater
+#endif
+  );
   if (!mem.IsReserved()) {
     // Try resetting {next_code_space_hint_}, which might fail if another thread
     // bumped it in the meantime.
